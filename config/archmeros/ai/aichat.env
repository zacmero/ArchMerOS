# ArchMerOS-local aichat overrides.
# This file pins the HUD to OpenRouter without mutating the portable config.
#
# The HUD now defaults to OpenRouter via the tracked config.
# The shared API key lives in /opt/mero_terminal/aichat.env as OPENROUTER_API_KEY.
#
# Example:
# ARCHMEROS_AICHAT_MODEL="openrouter:openrouter/free"
#
# ArchMerOS AI HUD also sources /opt/mero_terminal/aichat.env when it exists
# so the floating aichat window works inside the graphical session too.

ARCHMEROS_AICHAT_MODEL="openrouter:openrouter/free"
