{
  "name": "beacon",
  "layer": "top",
  "position": "right",
  "exclusive": true,
  "width": 204,
  "spacing": 4,
  "margin": "8 8 8 0",
  "reload_style_on_change": true,
  "output": "DP-1",
  "modules-left": ["custom/beacon", "custom/moon", "custom/whisper"],
  "modules-center": ["custom/spectrum", "custom/project", "custom/fabric", "custom/daemon", "custom/events"],
  "modules-right": ["custom/sigils"],
  "custom/beacon": {
    "format": "λ",
    "tooltip": true,
    "tooltip-format": "ARCHMEROS AI HUB\nLeft click: terminal\nRight click: open docked AI HUD",
    "on-click": "env -u MERO_FASTFETCH_SHOWN $HOME/.config/archmeros/scripts/archmeros-wezterm.sh terminal",
    "on-click-right": "$HOME/.config/archmeros/scripts/archmeros-ai-float.sh beacon"
  },
  "custom/moon": {
    "format": "{text}",
    "return-type": "json",
    "exec": "$HOME/.config/archmeros/scripts/archmeros-beacon-moon.py stream",
    "restart-interval": 2,
    "tooltip": true,
    "on-click": "$HOME/.config/archmeros/scripts/archmeros-beacon-moon.py show"
  },
  "custom/whisper": {
    "format": "{text}",
    "return-type": "json",
    "interval": 15,
    "exec": "$HOME/.config/archmeros/scripts/archmeros-beacon-moon.py whisper",
    "tooltip": true
  },
  "custom/spectrum": {
    "format": "{text}",
    "return-type": "json",
    "exec-if": "command -v cava >/dev/null 2>&1",
    "exec": "cava -p $HOME/.config/waybar/cava.conf | $HOME/.config/archmeros/scripts/archmeros-cava-waybar.py",
    "restart-interval": 2,
    "tooltip": false
  },
  "custom/project": {
    "format": "{text}",
    "return-type": "json",
    "interval": 15,
    "exec": "$HOME/.config/archmeros/scripts/archmeros-dp1-activity.py project",
    "tooltip": true
  },
  "custom/fabric": {
    "format": "{text}",
    "return-type": "json",
    "interval": 20,
    "exec": "$HOME/.config/archmeros/scripts/archmeros-dp1-activity.py fabric",
    "tooltip": true
  },
  "custom/events": {
    "format": "{text}",
    "return-type": "json",
    "interval": 30,
    "exec": "$HOME/.config/archmeros/scripts/archmeros-git-events.py",
    "on-click": "$HOME/.config/archmeros/scripts/archmeros-git-history.sh",
    "tooltip": true
  },
  "custom/daemon": {
    "format": "{text}",
    "return-type": "json",
    "exec": "$HOME/.config/archmeros/scripts/archmeros-beacon-familiar.py stream",
    "restart-interval": 2,
    "on-click": "$HOME/.config/archmeros/scripts/archmeros-ai-float.sh daemon",
    "on-click-right": "$HOME/.config/archmeros/scripts/archmeros-daemon-message.sh",
    "tooltip": true
  },
  "custom/sigils": {
    "format": "{text}",
    "return-type": "json",
    "interval": 2,
    "exec": "$HOME/.config/archmeros/scripts/archmeros-beacon-familiar.py sigils",
    "tooltip": true
  }
}
