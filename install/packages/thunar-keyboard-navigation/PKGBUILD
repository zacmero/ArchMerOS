# Arch Linux Thunar package with ArchMerOS keyboard focus navigation.

pkgname=thunar
pkgver=4.20.9
pkgrel=1.2
pkgdesc="Modern, fast and easy-to-use file manager for Xfce"
arch=('x86_64')
url="https://docs.xfce.org/xfce/thunar/start"
license=('GPL-2.0-or-later' 'LGPL-2.1-only')
groups=('xfce4')
depends=('desktop-file-utils' 'libexif' 'hicolor-icon-theme' 'libnotify'
         'pcre2' 'libgudev' 'exo' 'libxfce4util' 'libxfce4ui')
makedepends=('git' 'glib2-devel' 'gobject-introspection' 'xfce4-panel' 'xfce4-dev-tools')
optdepends=('catfish: file searching'
            'gvfs: trash support, mounting with udisk and remote filesystems'
            'tumbler: thumbnail previews'
            'thunar-volman: removable device management'
            'thunar-archive-plugin: archive creation and extraction'
            'thunar-media-tags-plugin: view/edit ID3/OGG tags')
source=("git+https://gitlab.xfce.org/xfce/thunar.git#tag=$pkgname-$pkgver"
        '0001-archmeros-keyboard-focus-navigation.patch')
sha256sums=('2d2933bb56b82c76b31d604dd69afdacaca654ddf13833f2df13a1a8ee51081b'
            '406c97bf28a7fbd1bddcd201b60d02671495b06c64f32aafee3c40b7dbf29f3b')

prepare() {
  cd "$pkgname"
  patch -Np1 -i "$srcdir/0001-archmeros-keyboard-focus-navigation.patch"
  cp /usr/share/libtool/build-aux/ltmain.sh .
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "$pkgname"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-gio-unix \
    --enable-gudev \
    --enable-notifications \
    --enable-exif \
    --enable-gtk-doc \
    --disable-debug \
    --enable-maintainer-mode
  make
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" install
}
