{
  "manifest_version": 3,
  "name": "ArchMerOS Photopea Workspace",
  "version": "1.1.0",
  "description": "Hide Photopea's advertising column and expand the editor.",
  "content_scripts": [
    {
      "matches": ["https://www.photopea.com/*"],
      "css": ["workspace.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.photopea.com/*"],
      "js": ["workspace.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
