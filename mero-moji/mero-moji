#!/usr/bin/python
import subprocess
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango

from catalog import load_catalog, search
from insertion import active_window, insert


APP_ID = "org.archmeros.MeroMoji"
COLUMNS = 8
RETURN_KEYS = (Gdk.KEY_Return, Gdk.KEY_KP_Enter)
ARROWS = {
    Gdk.KEY_Left: -1,
    Gdk.KEY_Right: 1,
    Gdk.KEY_Up: -COLUMNS,
    Gdk.KEY_Down: COLUMNS,
    Gdk.KEY_Page_Up: -4 * COLUMNS,
    Gdk.KEY_Page_Down: 4 * COLUMNS,
}


class Picker(Gtk.ApplicationWindow):
    def __init__(self, app, target):
        super().__init__(application=app, title="Mero Moji", default_width=576,
                         default_height=440, resizable=False, decorated=False)
        self.add_css_class("mero-moji")
        self.target = target
        self.version, self.catalog = load_catalog()
        self.groups = list(dict.fromkeys(entry.group for entry in self.catalog))
        self.results = []
        self.tones = None
        self.browsing = False

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        body.add_css_class("picker")
        self.set_child(body)

        header = Gtk.Box(spacing=12)
        body.append(header)
        title = Gtk.Label(label="Mero Moji", xalign=0, hexpand=True)
        title.add_css_class("title")
        header.append(title)
        close = Gtk.Button(icon_name="window-close-symbolic", tooltip_text="Close")
        close.add_css_class("flat")
        close.connect("clicked", lambda _button: self.close())
        header.append(close)

        filters = Gtk.Box(spacing=8)
        body.append(filters)
        self.entry = Gtk.Entry(placeholder_text="Search emoji", hexpand=True,
                               primary_icon_name="system-search-symbolic")
        self.entry.connect("changed", self.query_changed)
        filters.append(self.entry)
        self.category = Gtk.DropDown.new_from_strings(
            ["All emoji", f"New in {self.version}", *self.groups]
        )
        self.category.set_tooltip_text("Filter by category")
        self.category.connect("notify::selected", self.query_changed)
        filters.append(self.category)

        self.model = Gtk.StringList.new([])
        self.selection = Gtk.SingleSelection(model=self.model)
        self.selection.connect("notify::selected", lambda *_: self.update_details())
        factory = Gtk.SignalListItemFactory()
        factory.connect("setup", self.setup_cell)
        factory.connect("bind", self.bind_cell)
        self.grid = Gtk.GridView(model=self.selection, factory=factory, min_columns=COLUMNS,
                                 max_columns=COLUMNS, single_click_activate=True)
        self.grid.connect("activate", lambda _grid, index: self.use(index))
        self.grid.add_css_class("emoji-grid")
        self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                         vscrollbar_policy=Gtk.PolicyType.AUTOMATIC, vexpand=True)
        self.scroll.set_child(self.grid)
        body.append(self.scroll)

        detail = Gtk.Box(spacing=8)
        body.append(detail)
        self.name = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        detail.append(self.name)
        self.tone_button = Gtk.Button(label="Skin tones", tooltip_text="Skin tones (Ctrl+Enter)")
        self.tone_button.connect("clicked", lambda _button: self.toggle_tones())
        detail.append(self.tone_button)

        self.hint = Gtk.Label(xalign=0)
        self.hint.add_css_class("hint")
        body.append(self.hint)

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.handle_key)
        self.add_controller(keys)
        self.query_changed()
        self.set_focus(self.entry)

    def setup_cell(self, _factory, item):
        label = Gtk.Label()
        label.add_css_class("emoji")
        item.set_child(label)
        click = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)
        click.connect("pressed", lambda *_: self.toggle_tones(item.get_position()))
        label.add_controller(click)

    def bind_cell(self, _factory, item):
        glyph, name = self.visible_items()[item.get_position()]
        label = item.get_child()
        label.set_label(glyph)
        label.set_tooltip_text(name)
        label.update_property([Gtk.AccessibleProperty.LABEL], [name])

    def visible_items(self):
        return self.tones if self.tones is not None else self.results

    def query_changed(self, widget=None, *_):
        if self.tones is not None:
            self.close_tones()
        self.browsing = False
        group = self.category.get_selected()
        if group == 0:
            candidates = self.catalog
        elif group == 1:
            candidates = [entry for entry in self.catalog if entry.version == self.version]
        else:
            candidates = [entry for entry in self.catalog if entry.group == self.groups[group - 2]]
        self.entries = search(candidates, self.entry.get_text())
        self.results = [(entry.glyph, entry.name) for entry in self.entries]
        self.refresh_grid()
        if widget is self.category:
            self.entry.grab_focus()

    def refresh_grid(self, index=0):
        items = self.visible_items()
        self.model.splice(0, self.model.get_n_items(), [glyph for glyph, _ in items])
        self.scroll.get_vadjustment().set_value(0)
        if items:
            self.select(index)
        self.update_details()

    def select(self, index):
        self.selection.set_selected(index)
        self.grid.scroll_to(index, Gtk.ListScrollFlags.NONE, None)

    def editing(self):
        return bool(self.entry.get_text()) and not self.browsing and self.tones is None

    def update_details(self):
        index = self.selection.get_selected()
        items = self.visible_items()
        self.name.set_label(items[index][1] if index < len(items) else "No emoji found")
        self.tone_button.set_label("Back to results" if self.tones is not None else "Skin tones")
        self.tone_button.set_visible(self.tones is not None or (
            index < len(self.entries) and bool(self.entries[index].variants)
        ))
        if self.tones is not None:
            self.hint.set_label("Arrows  Browse tones     Enter  Insert     Backspace  Results")
        elif self.editing():
            self.hint.set_label("Enter  Browse results     Esc  Close")
        elif self.browsing:
            self.hint.set_label("Arrows  Browse     Enter  Insert     Backspace  Edit     Alt+C  Copy")
        else:
            self.hint.set_label("Arrows  Browse     Enter  Insert     Alt+C  Copy")

    def toggle_tones(self, index=None):
        if self.tones is not None:
            self.close_tones()
            return
        if index is None:
            index = self.selection.get_selected()
        if index >= len(self.entries) or not self.entries[index].variants:
            return
        self.result_index = index
        entry = self.entries[index]
        self.tones = [(entry.glyph, f"{entry.name} · default"), *entry.variants]
        self.entry.set_editable(False)
        self.category.set_sensitive(False)
        self.entry.grab_focus()
        self.refresh_grid()

    def close_tones(self):
        self.tones = None
        self.entry.set_editable(True)
        self.category.set_sensitive(True)
        self.entry.grab_focus()
        self.refresh_grid(self.result_index)

    def handle_key(self, _controller, key, _code, modifiers):
        index = self.selection.get_selected()
        if key == Gdk.KEY_Escape:
            self.close() if self.tones is None else self.close_tones()
            return True
        if key in RETURN_KEYS and modifiers & Gdk.ModifierType.CONTROL_MASK:
            self.toggle_tones()
            return True
        if key == Gdk.KEY_c and modifiers & Gdk.ModifierType.ALT_MASK:
            self.use(index, copy=True)
            return True
        focus = self.get_focus()
        if focus and not any(
            focus is widget or focus.is_ancestor(widget) for widget in (self.entry, self.grid)
        ):
            return False
        if key == Gdk.KEY_BackSpace:
            if self.tones is not None:
                self.close_tones()
                return True
            if self.browsing:
                self.browsing = False
                self.entry.grab_focus()
                self.update_details()
                return True
        if key in RETURN_KEYS:
            if self.editing():
                if self.results:
                    self.browsing = True
                    self.update_details()
            else:
                self.use(index)
            return True
        if key in ARROWS and not self.editing():
            if self.visible_items():
                self.select(max(0, min(index + ARROWS[key], len(self.visible_items()) - 1)))
            return True
        return False

    def use(self, index, copy=False):
        items = self.visible_items()
        if index >= len(items) or not self.get_visible():
            return
        glyph, _ = items[index]
        self.set_visible(False)
        self.get_display().flush()
        GLib.idle_add(self.deliver, glyph, copy)

    def deliver(self, glyph, copy):
        try:
            if copy:
                subprocess.run(["wl-copy", "--", glyph], check=True, timeout=2)
            else:
                insert(glyph, self.target)
        except (OSError, subprocess.SubprocessError, ValueError, RuntimeError) as error:
            self.present()
            self.hint.set_label(str(error) if isinstance(error, RuntimeError) else (
                "Clipboard unavailable." if copy else "Insertion unavailable. Alt+C copies the emoji."
            ))
        else:
            self.close()
        return GLib.SOURCE_REMOVE


class MeroMoji(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        if window := self.get_active_window():
            window.present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_path(str(Path(__file__).resolve().with_name("style.css")))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        try:
            target = active_window()
        except (OSError, subprocess.SubprocessError, ValueError):
            target = None
        Picker(self, target).present()


if __name__ == "__main__":
    raise SystemExit(MeroMoji().run())
