[Unit]
Description=ArchMerOS Sentinel Achievement Watcher
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin"
ExecStart=/usr/bin/env sentinel -startminimized
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
