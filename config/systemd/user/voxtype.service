[Unit]
Description=Voxtype local dictation
PartOf=graphical-session.target
Requires=archmeros-audio-policy.service
After=wayland-session-waitenv.service archmeros-audio-policy.service

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment="PIPEWIRE_ALSA=target.object=archmeros_ur44_mic node.dont-fallback=true node.dont-move=true"
ExecCondition=/usr/bin/env sh -c 'command -v voxtype >/dev/null'
ExecStart=/usr/bin/env voxtype daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
